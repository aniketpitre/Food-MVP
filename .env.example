# Copy to .env and fill in. Never commit .env.

# Generate each with: openssl rand -hex 32
POSTGRES_PASSWORD=change-me
JWT_SECRET=change-me-to-at-least-32-random-characters

# The address phones use to reach the API. Use your server's LAN IP for home testing
# (e.g. http://192.168.1.20:8080) or your domain with the https profile.
PUBLIC_URL=http://localhost:8080
API_PORT=8080

# Accounts with these emails become admins (moderation queue) when they sign up or sign in.
ADMIN_EMAILS=you@example.com
CONTACT_EMAIL=you@example.com

# Seed the demo city (Nashik), categories and 30 demo dishes on first start.
SEED_ON_START=true
# DEMO ONLY: adds 40 "demo_" accounts with recommendations so every tab has data.
# Set to false (and run: docker compose exec api node dist/cli.js remove-demo) before real users join.
DEMO_ACTIVITY=true

# How often scores are fully recomputed (seconds). Each action also updates its own dish at once.
RANK_REFRESH_SECONDS=300

# For the https profile: a domain whose DNS points at this server.
# DOMAIN=worthabite.example.com

APP_DOWNLOAD_URL=https://github.com/aniketpitre/Food-MVP/releases/latest
BACKUP_KEEP_DAYS=14

# Real photos of places (optional).
# Mapillary street photos of shopfronts, CC BY-SA: free token from https://www.mapillary.com/dashboard/developers
# then run: docker compose exec api node dist/cli.js fetch-place-photos <city>
MAPILLARY_TOKEN=
# Google Maps photos on place pages, fetched live (never stored). Needs a Google Cloud key with
# "Places API (New)" enabled and billing on; 30 a day stays inside the 1,000 free a month.
GOOGLE_PLACES_API_KEY=
GOOGLE_PHOTOS_DAILY_LIMIT=30

# Instant notifications (optional). Without these, phones still get notifications: they
# check every 30 seconds while the app is open and every 15 minutes in the background.
# With Firebase, a new message, follower, story or dish nearby reaches the phone in seconds.
# 1. console.firebase.google.com: create a project, add an Android app with package app.worthabite.
# 2. Project settings > General > Your apps: copy the App ID, Web API key and Project number.
# 3. Project settings > Service accounts > Generate new private key: base64 the JSON file
#    (base64 -w0 key.json) and paste it below. Keep it secret; it never goes in the app.
FCM_SERVICE_ACCOUNT=
FCM_API_KEY=
FCM_APP_ID=
FCM_SENDER_ID=

# Email for two-step sign-in codes (needed to turn two-step sign-in on). Any SMTP account works,
# e.g. Gmail with an App Password (smtp.gmail.com, port 587), Brevo or Amazon SES.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=WorthAbite <no-reply@example.com>
# India-time hours when the daily "turn on two-step sign-in" reminder may go out.
REMIND_HOURS=10-20
